# Copy to .env and adjust. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint; default is the bundled Ollama) ---
LLM_ENABLED=true
# qwen3:4b runs on CPU (~3 GB RAM). With a GPU, qwen3:8b is more accurate.
LLM_MODEL=qwen3:4b
# Ollama ignores the key; set a real one for hosted endpoints
LLM_API_KEY=ollama
LLM_TIMEOUT_S=60
# Max elements per page sent to the LLM
LLM_MAX_ITEMS=40
# Disable reasoning mode on Qwen3-style models (faster)
LLM_NO_THINK=true
# LLM_BASE_URL is set by docker-compose. When running the backend outside Docker:
# LLM_BASE_URL=http://localhost:11434/v1

# --- Threat signals ---
# Free key: https://developers.google.com/safe-browsing/v4/get-started
# Leave empty to skip the check. Note: checked URLs are sent to Google.
SAFE_BROWSING_API_KEY=
THREAT_TIMEOUT_S=6
