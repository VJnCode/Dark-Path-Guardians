{
  "manifest_version": 3,
  "name": "Dark-Path Guardians",
  "version": "2.0.0",
  "description": "Detects dark patterns and threat signals on the current page.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/detective.png"
  },
  "icons": {
    "128": "icons/detective.png"
  }
}
